{
  "name": "@opentelemetry/instrumentation-aws-powertools-lambda",
  "version": "0.45.0",
  "description": "OpenTelemetry instrumentation for `aws-powertools-lambda` function memoization using lru-cache",

  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",

  "repository": "open-telemetry/opentelemetry-js-contrib",
  "scripts": {
    "test": "mocha --require '@opentelemetry/contrib-test-utils' 'test/**/*.test.ts'",
    "test-all-versions": "tav",
    "tdd": "npm run test -- --watch-extensions ts --watch",
    "clean": "rimraf build/*",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:readme": "node ../../../scripts/lint-readme.js",
    "prewatch": "npm run precompile",
    "prepublishOnly": "npm run compile",
    "version:update": "node ../../../scripts/version-update.js",
    "compile": "tsc -p ."
  },
  "keywords": [
    "aws-powertools-lambda",
    "instrumentation",
    "nodejs",
    "opentelemetry",
    "tracing"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "files": [
    "build/src/**/*.js",
    "build/src/**/*.js.map",
    "build/src/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@aws-lambda-powertools/batch": "2.16.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/contrib-test-utils": "^0.46.0",
    "@types/mocha": "10.0.10",
    "@types/node": "18.18.14",
    "expect": "29.2.0",
    "nyc": "15.1.0",
    "rimraf": "5.0.10",
    "test-all-versions": "6.1.0",
    "typescript": "5.0.4"
  },
  "dependencies": {
    "@opentelemetry/instrumentation": "^0.200.0"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/plugins/node/instrumentation-aws-lambda-powertools#readme"
}
